<?xml version="1.0" encoding="utf-8"?>
<!--
  Only window changes, and the package list is narrowed at runtime to the apps on the Screen
  time list, so LifeTrack never hears about anything else on the phone. No window content.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="500"
    android:canRetrieveWindowContent="false"
    android:description="@string/limit_guard_description" />
